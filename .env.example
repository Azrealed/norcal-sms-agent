# smsblast.io — paste the real key only in Fly secrets or a local .env that is not committed
SMSBLAST_API_KEY=your_smsblast_api_key_here
SMSBLAST_FROM_NUMBER=+18884645732

# DeepSeek via OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
AI_MODEL=deepseek/deepseek-chat

# App
SESSION_SECRET=generate-a-random-secret-here
PORT=8080

# Dashboard login. Set a strong password in Fly. Do not leave the old default in production.
DASHBOARD_PASSWORD=choose-a-strong-password

# Test mode stays ON until this is set to false.
# While it is on, the AI texts back only the numbers listed here (comma-separated).
AI_TEST_MODE=true
AI_REPLY_ALLOWLIST=

# Extra numbers that must never be texted, besides the built-in suppressed number.
SUPPRESSED_NUMBERS=

# GoHighLevel Private Integration token. If these are empty, CRM push is skipped and the bot keeps running.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_PIPELINE_NAME=SMS Blast Leads
# Optional. Only needed if notes must be attributed to a specific GHL user.
GHL_USER_ID=
