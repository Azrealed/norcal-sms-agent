# smsblast.io
SMSBLAST_API_KEY=your_smsblast_api_key_here
SMSBLAST_FROM_NUMBER=+18884645732

# DeepSeek via OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
AI_MODEL=deepseek/deepseek-chat

# Tracersfy (DNC Scrubbing & Skip Tracing)
TRACERFY_API_KEY=your_tracerfy_api_key_here

# App
SESSION_SECRET=generate-a-random-secret-here
PORT=8080

# Auth (simple password for dashboard)
DASHBOARD_PASSWORD=choose-a-strong-password

# Test mode stays ON until this is set to false.
# While it is on, automatic texts go only to the numbers listed here.
AI_TEST_MODE=true
AI_REPLY_ALLOWLIST=

# Extra numbers that must never be texted, besides the built-in suppressed number.
SUPPRESSED_NUMBERS=

# GoHighLevel. If the token or location id is empty, CRM push is skipped and the bot keeps running.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_PIPELINE_NAME=SMS Blast Leads
GHL_USER_ID=

# Optional alerts. Leave blank to disable.
GHL_WEBHOOK_URL=
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITOR_TOKEN=
BATCHLEADS_API_KEY=
PROPERTY_RADAR_KEY=
